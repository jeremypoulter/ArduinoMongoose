digraph "MongooseHttpServerRequest"
{
 // LATEX_PDF_SIZE
  bgcolor="transparent";
  edge [fontname=Helvetica,fontsize=10,labelfontname=Helvetica,labelfontsize=10];
  node [fontname=Helvetica,fontsize=10,shape=box,height=0.2,width=0.4];
  rankdir="LR";
  Node1 [id="Node000001",label="MongooseHttpServerRequest",height=0.2,width=0.4,color="gray40", fillcolor="grey60", style="filled", fontcolor="black",tooltip="Represents an incoming HTTP request."];
  Node2 -> Node1 [id="edge1_Node000001_Node000002",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node2 [id="Node000002",label="MongooseHttpServerConnection",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$classMongooseHttpServerConnection.html",tooltip=" "];
  Node3 -> Node2 [id="edge2_Node000002_Node000003",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node3 [id="Node000003",label="MongooseSocket",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$classMongooseSocket.html",tooltip="Base class for Mongoose network sockets."];
  Node4 -> Node1 [id="edge3_Node000001_Node000004",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node4 [id="Node000004",label="MongooseHttpMessage",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$classMongooseHttpMessage.html",tooltip=" "];
  Node5 -> Node1 [id="edge4_Node000001_Node000005",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" _response",fontcolor="grey" ];
  Node5 [id="Node000005",label="MongooseHttpServerResponse",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$classMongooseHttpServerResponse.html",tooltip="Base class for HTTP server responses."];
  Node6 -> Node1 [id="edge5_Node000001_Node000006",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" _endpoint",fontcolor="grey" ];
  Node6 [id="Node000006",label="MongooseHttpServerEndpoint",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$classMongooseHttpServerEndpoint.html",tooltip=" "];
}
